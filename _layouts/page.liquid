---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {% include scala_page_header.liquid %}

  <article
    {% if page.bibliography_page %}
      class="scala-bibliography-list"
    {% endif %}
  >
    {% if page.collection == 'projects' %}{% include research_project_context.liquid %}{% endif %}
    {{ content }}
    {% if page.collection == 'projects' %}
      <nav class="scala-project-return-links" aria-label="More research">
        <a href="{{ '/projects/' | relative_url }}">All research projects</a><a href="{{ '/research/' | relative_url }}">Research themes</a
        ><a href="{{ '/software/' | relative_url }}">Research software</a>
      </nav>
    {% endif %}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.plugins contains 'al_comments' %}
    {% include plugins/al_comments.liquid %}
  {% endif %}
</div>
