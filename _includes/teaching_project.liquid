{% assign project = site.data.teaching.projects | where: 'id', page.teaching_project_id | first %}
{% assign member = site.data.people | where: 'id', project.member_id | first %}
{% if project.summary %}
  <p>{{ project.summary | escape }}</p>
{% endif %}
{% if project.student %}
  <p>
    <strong>Student:</strong>
    {% if member %}
      <a href="{{ member.profile_url | relative_url }}">{{ project.student | escape }}</a>
    {% else %}
      {{ project.student | escape }}
    {% endif %}
  </p>
{% endif %}
{% if project.institution %}
  <p><strong>Institution:</strong> {{ project.institution | escape }}</p>
{% endif %}
{% if project.supervisors %}
  <p><strong>Supervision:</strong> {{ project.supervisors | escape }}</p>
{% endif %}
{% if project.co_supervisors %}
  <p><strong>Co-supervision:</strong> {{ project.co_supervisors | escape }}</p>
{% endif %}
{% if project.collaboration %}
  <p><strong>Collaboration:</strong> {{ project.collaboration | escape }}</p>
{% endif %}
{% if project.links.size > 0 %}
  <h2>Documents and links</h2>
  <ul>
    {% for link in project.links %}
      <li>
        <a href="{{ link.url | relative_url }}">{{ link.label | escape }}</a>
      </li>
    {% endfor %}
  </ul>
{% endif %}
